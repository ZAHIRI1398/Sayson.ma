{
  "name": "sayson-ma",
  "compatibility_date": "2025-08-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "CATALOGUES",
      "bucket_name": "sayson-catalogues"
    }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts"
}
